#
# Copy this file to .env.local and fill in the two values below.
# .env.local is gitignored, so these never get committed.
#
# HOW TO GET THE APP PASSWORD (2 minutes):
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#      (Google only offers App Passwords once 2FA is enabled.)
#   2. Go to https://myaccount.google.com/apppasswords
#   3. App name: "Portfolio site"  ->  Create
#   4. Copy the 16-character password Google shows you.
#      Paste it below WITHOUT spaces.
#
# Use the App Password, NOT your normal Gmail login password.
# Restart the server after editing (`npm run dev` or `npm start`).

GMAIL_USER=muneebdevs07@gmail.com
GMAIL_APP_PASSWORD=
